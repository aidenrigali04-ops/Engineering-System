{
  "name": "engineering-system",
  "version": "0.1.0",
  "description": "A learning playground for professional software engineering tooling",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start:built": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --test",
    "test:watch": "node --env-file-if-exists=.env --test --watch",
    "test:coverage": "node --env-file-if-exists=.env --test --experimental-test-coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run lint:md && npm run format:check && npm test",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "markdownlint-cli2": "0.22.1",
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
