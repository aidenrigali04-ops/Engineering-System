generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Repository {
  id        String   @id
  owner     String
  name      String
  fullName  String   @map("full_name")
  trackedAt DateTime @map("tracked_at") @db.Timestamptz(6)

  @@map("repositories")
}
